{
  "name": "AdBooking",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "screen_id": {
      "type": "string"
    },
    "advertiser_email": {
      "type": "string"
    },
    "venue_owner_email": {
      "type": "string"
    },
    "org_id": {
      "type": "string",
      "description": "ID of the venue-side Organization that owns the screen (snapshot at booking time)"
    },
    "description": {
      "type": "string",
      "description": "Optional booking description (up to 1000 characters)",
      "maxLength": 1000
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "slots_booked": {
      "type": "number",
      "default": 1
    },
    "price_per_week": {
      "type": "number"
    },
    "weeks": {
      "type": "number",
      "description": "Booking duration in weeks (snapshot at booking time)"
    },
    "total_amount": {
      "type": "number"
    },
    "commission_rate_snapshot": {
      "type": "number",
      "description": "Organization commission_rate captured at booking time \u2014 drives settlement even if the org rate changes later"
    },
    "platform_fee": {
      "type": "number",
      "description": "total_amount \u00d7 commission_rate_snapshot / 100"
    },
    "venue_earnings": {
      "type": "number",
      "description": "total_amount \u2212 platform_fee"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_payment",
        "active",
        "paused",
        "completed",
        "cancelled"
      ],
      "default": "pending_payment"
    },
    "checkout_url": {
      "type": "string",
      "description": "Gateway checkout URL returned by the payment provider"
    },
    "impressions": {
      "type": "number",
      "default": 0
    },
    "plays": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "campaign_id",
    "screen_id"
  ]
}