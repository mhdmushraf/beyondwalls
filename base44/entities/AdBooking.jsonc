{
  "description": "One advertiser booking on one venue screen. Created only by the marketplaceBook function.",
  "name": "AdBooking",
  "properties": {
    "advertiser_email": {
      "type": "string"
    },
    "advertiser_member_user_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "advertiser_org_id": {
      "type": "string"
    },
    "advertiser_org_name": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    },
    "campaign_name": {
      "type": "string"
    },
    "checkout_url": {
      "type": "string"
    },
    "commission_rate_snapshot": {
      "description": "Platform % kept at booking time",
      "type": "number"
    },
    "creative_rejection_reason": {
      "type": "string"
    },
    "creative_reviewed_at": {
      "type": "string"
    },
    "creative_reviewed_by": {
      "type": "string"
    },
    "creative_status": {
      "default": "pending_review",
      "enum": [
        "pending_review",
        "approved",
        "rejected"
      ],
      "type": "string"
    },
    "creative_type": {
      "default": "image",
      "enum": [
        "image",
        "video"
      ],
      "type": "string"
    },
    "creative_url": {
      "type": "string"
    },
    "description": {
      "maxLength": 1000,
      "type": "string"
    },
    "end_date": {
      "format": "date",
      "type": "string"
    },
    "impressions": {
      "default": 0,
      "type": "number"
    },
    "invoice_id": {
      "type": "string"
    },
    "org_id": {
      "description": "ID of the venue-side Organization that owns the screen (snapshot at booking time)",
      "type": "string"
    },
    "platform_fee": {
      "type": "number"
    },
    "plays": {
      "default": 0,
      "type": "number"
    },
    "price_per_week": {
      "type": "number"
    },
    "screen_id": {
      "type": "string"
    },
    "screen_name": {
      "type": "string"
    },
    "slots_booked": {
      "default": 1,
      "type": "number"
    },
    "start_date": {
      "format": "date",
      "type": "string"
    },
    "status": {
      "default": "pending_payment",
      "enum": [
        "pending_payment",
        "active",
        "paused",
        "completed",
        "cancelled"
      ],
      "type": "string"
    },
    "total_amount": {
      "type": "number"
    },
    "venue_earnings": {
      "type": "number"
    },
    "venue_id": {
      "type": "string"
    },
    "venue_member_user_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "venue_name": {
      "type": "string"
    },
    "venue_owner_email": {
      "type": "string"
    },
    "weeks": {
      "type": "number"
    }
  },
  "required": [
    "campaign_id",
    "screen_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.advertiser_member_user_ids": "{{user.id}}"
        },
        {
          "data.venue_member_user_ids": "{{user.id}}"
        },
        {
          "data.advertiser_email": "{{user.email}}"
        },
        {
          "data.venue_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}