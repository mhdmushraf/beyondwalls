{
  "name": "MediaAsset",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "description": "Email of venue owner"
    },
    "name": {
      "type": "string",
      "description": "Asset name/label"
    },
    "description": {
      "type": "string",
      "description": "Optional asset description (up to 1000 characters)",
      "maxLength": 1000
    },
    "file_url": {
      "type": "string",
      "description": "URL of uploaded file"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image"
    },
    "file_size_kb": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "used_on_screens": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Screen IDs using this asset"
    }
  },
  "required": [
    "owner_email",
    "name",
    "file_url",
    "file_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}