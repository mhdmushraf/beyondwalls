{
  "name": "MediaAsset",
  "properties": {
    "description": {
      "maxLength": 1000,
      "type": "string"
    },
    "duration_seconds": {
      "type": "number"
    },
    "expires_on": {
      "format": "date",
      "type": "string"
    },
    "file_size_kb": {
      "type": "number"
    },
    "file_type": {
      "default": "image",
      "enum": [
        "image",
        "video"
      ],
      "type": "string"
    },
    "file_url": {
      "description": "URL of uploaded file",
      "type": "string"
    },
    "height_px": {
      "type": "number"
    },
    "name": {
      "description": "Asset name/label",
      "type": "string"
    },
    "org_id": {
      "description": "Business that owns the asset",
      "type": "string"
    },
    "org_member_user_ids": {
      "description": "Denormalized from Organization.member_user_ids \u2014 drives RLS",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "owner_email": {
      "description": "Email of uploader",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "used_on_screens": {
      "description": "Screen IDs using this asset",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "width_px": {
      "type": "number"
    }
  },
  "required": [
    "name",
    "file_url",
    "file_type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.org_member_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.org_member_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.org_member_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}