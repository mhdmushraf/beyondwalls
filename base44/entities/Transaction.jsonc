{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "topup",
        "campaign_payment",
        "payout",
        "refund",
        "platform_fee",
        "earnings"
      ],
      "description": "Transaction type"
    },
    "amount": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed"
      ],
      "default": "completed"
    },
    "reference_id": {
      "type": "string",
      "description": "Campaign/booking/payout ID"
    },
    "balance_before": {
      "type": "number"
    },
    "balance_after": {
      "type": "number"
    }
  },
  "required": [
    "user_email",
    "type",
    "amount"
  ]
}