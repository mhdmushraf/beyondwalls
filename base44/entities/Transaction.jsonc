{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "org_id": {
      "type": "string",
      "description": "ID of the Organization this transaction belongs to (for ledger queries)"
    },
    "type": {
      "type": "string",
      "enum": [
        "topup",
        "campaign_payment",
        "booking_payment",
        "payout",
        "refund",
        "platform_fee",
        "earnings"
      ],
      "description": "Transaction type"
    },
    "amount": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed"
      ],
      "default": "completed"
    },
    "reference_id": {
      "type": "string",
      "description": "Campaign/booking/payout ID"
    },
    "balance_before": {
      "type": "number"
    },
    "balance_after": {
      "type": "number"
    }
  },
  "required": [
    "user_email",
    "type",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.org_id": "{{user.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}