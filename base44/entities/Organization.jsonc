{
  "name": "Organization",
  "properties": {
    "advertiser_status": {
      "default": "none",
      "enum": [
        "none",
        "requested",
        "approved"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green"
      ],
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "auto_approve_creative": {
      "default": false,
      "type": "boolean"
    },
    "billing_email": {
      "description": "Where invoices are sent",
      "type": "string"
    },
    "business_modes": {
      "description": "What the business signed up to do: host screens, advertise, or both",
      "items": {
        "enum": [
          "venue",
          "advertiser"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "commercial_plan": {
      "default": "revenue_share",
      "description": "revenue_share = free join, 30% commission; saas = per-screen fee, 0% commission",
      "enum": [
        "revenue_share",
        "saas"
      ],
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "commission_rate": {
      "default": 30,
      "description": "Percent Beyond Walls keeps from marketplace ads on this business's screens (30 standard, 15 Connect partner, 40/50 partner venues). Admin only.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "number"
    },
    "emirate": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "logo_url": {
      "description": "Organization logo",
      "type": "string"
    },
    "member_user_ids": {
      "description": "Denormalized list of member user ids for access control",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "name": {
      "description": "Organization / business name",
      "type": "string"
    },
    "rejection_reason": {
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "screen_count": {
      "default": 0,
      "description": "Denormalized count of screens owned by this org",
      "type": "number"
    },
    "status": {
      "default": "pending",
      "description": "Business verification status",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "suspended"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red",
        "gray"
      ],
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "trade_license_number": {
      "type": "string"
    },
    "trade_license_url": {
      "description": "Private file_uri of the uploaded trade licence",
      "type": "string"
    },
    "trn": {
      "description": "UAE tax registration number, printed on invoices",
      "type": "string"
    },
    "type": {
      "description": "Organization type, chosen at signup",
      "enum": [
        "advertiser",
        "venue",
        "enterprise",
        "agency"
      ],
      "type": "string"
    },
    "whatsapp": {
      "description": "WhatsApp number with country code",
      "type": "string"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.member_user_ids": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_user_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}