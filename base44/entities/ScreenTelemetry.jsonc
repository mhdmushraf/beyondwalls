{
  "name": "ScreenTelemetry",
  "type": "object",
  "properties": {
    "screen_id": {
      "type": "string",
      "description": "ID of the Screen this telemetry belongs to"
    },
    "org_id": {
      "type": "string",
      "description": "Denormalized from Screen for RLS"
    },
    "org_member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Denormalized from Screen.org_member_user_ids \u2014 drives RLS"
    },
    "is_online": {
      "type": "boolean",
      "default": false
    },
    "last_heartbeat": {
      "type": "string",
      "description": "ISO timestamp of last heartbeat"
    },
    "player_version": {
      "type": "string"
    },
    "current_session_id": {
      "type": "string"
    },
    "session_started_at": {
      "type": "string"
    },
    "uptime_seconds": {
      "type": "number",
      "default": 0
    },
    "current_ad_index": {
      "type": "number",
      "default": 0
    },
    "current_playlist_length": {
      "type": "number",
      "default": 0
    },
    "current_content_name": {
      "type": "string"
    },
    "player_active": {
      "type": "boolean",
      "default": false
    },
    "ads_played_count": {
      "type": "number",
      "default": 0
    },
    "total_playtime": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "screen_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.org_member_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.org_member_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}