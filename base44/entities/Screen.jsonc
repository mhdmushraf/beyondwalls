{
  "name": "Screen",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "ID of the Organization that owns this screen"
    },
    "org_member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Denormalized from parent Organization.member_user_ids \u2014 drives RLS on this screen. Updated when the screen is created or when org membership changes."
    },
    "monetization_mode": {
      "type": "string",
      "enum": [
        "marketplace",
        "self_serve",
        "hybrid"
      ],
      "default": "marketplace",
      "description": "How this screen monetizes ad slots"
    },
    "venue_id": {
      "type": "string",
      "description": "Associated venue ID"
    },
    "name": {
      "type": "string",
      "description": "Screen name/identifier"
    },
    "description": {
      "type": "string",
      "description": "Optional description of the screen (up to 1000 characters)",
      "maxLength": 1000
    },
    "setup_code": {
      "type": "string",
      "description": "Unique setup code for player (BW- prefix)"
    },
    "screen_pin": {
      "type": "string",
      "description": "6-digit PIN for secondary authentication"
    },
    "device_token": {
      "type": "string",
      "description": "Secure token for kiosk autologin"
    },
    "screen_image_url": {
      "type": "string",
      "description": "Photo of the physical screen"
    },
    "default_image_url": {
      "type": "string",
      "description": "Default image shown when screen is stopped or has no content"
    },
    "width_px": {
      "type": "number",
      "description": "Screen width in pixels"
    },
    "height_px": {
      "type": "number",
      "description": "Screen height in pixels"
    },
    "display_mode": {
      "type": "string",
      "enum": [
        "fit",
        "stretch",
        "fill"
      ],
      "default": "fit"
    },
    "total_slots": {
      "type": "number",
      "default": 10,
      "description": "Total ad slots"
    },
    "public_ad_slots": {
      "type": "number",
      "default": 7,
      "description": "Slots for public advertisers"
    },
    "internal_slots": {
      "type": "number",
      "default": 3,
      "description": "Slots for internal/owner content"
    },
    "slot_duration": {
      "type": "number",
      "enum": [
        15,
        30,
        45,
        60
      ],
      "default": 30,
      "description": "Seconds per slot"
    },
    "price_per_week": {
      "type": "number",
      "description": "Price per slot per week (AED)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "offline",
        "pending"
      ],
      "default": "pending"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "player_command": {
      "type": "string"
    },
    "location_description": {
      "type": "string",
      "description": "Where screen is placed in venue"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejection_reason": {
      "type": "string"
    },
    "total_impressions": {
      "type": "number",
      "default": 0
    },
    "total_revenue": {
      "type": "number",
      "default": 0
    },
    "owner_slot_1_url": {
      "type": "string"
    },
    "owner_slot_1_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image"
    },
    "owner_slot_2_url": {
      "type": "string"
    },
    "owner_slot_2_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image"
    },
    "owner_slot_3_url": {
      "type": "string"
    },
    "owner_slot_3_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image"
    },
    "owner_slot_4_url": {
      "type": "string"
    },
    "owner_slot_4_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image"
    },
    "owner_slot_5_url": {
      "type": "string"
    },
    "owner_slot_5_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image"
    },
    "owner_slot_6_url": {
      "type": "string"
    },
    "owner_slot_6_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image"
    }
  },
  "required": [
    "name",
    "venue_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.approval_status": "approved"
            },
            {
              "data.status": "active"
            }
          ]
        },
        {
          "data.org_member_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.org_member_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.org_member_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}