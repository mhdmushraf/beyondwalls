{
  "name": "Screen",
  "properties": {
    "accept_offers": {
      "default": true,
      "description": "Advertisers may offer a lower weekly price (Make an offer)",
      "type": "boolean"
    },
    "approval_status": {
      "default": "pending",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "type": "string"
    },
    "current_item": {
      "description": "What the player last reported as playing",
      "type": "string"
    },
    "default_image_url": {
      "description": "Image shown when the screen is stopped or has no content",
      "type": "string"
    },
    "description": {
      "maxLength": 1000,
      "type": "string"
    },
    "device_token": {
      "description": "Secret the paired player uses to call the player endpoints",
      "type": "string"
    },
    "display_mode": {
      "default": "fit",
      "enum": [
        "fit",
        "stretch",
        "fill"
      ],
      "type": "string"
    },
    "height_px": {
      "description": "Screen height in pixels",
      "type": "number"
    },
    "internal_slots": {
      "default": 3,
      "type": "number"
    },
    "is_online": {
      "default": false,
      "type": "boolean"
    },
    "last_heartbeat": {
      "type": "string"
    },
    "last_snapshot_url": {
      "description": "Private file_uri of the most recent player snapshot",
      "type": "string"
    },
    "location_description": {
      "type": "string"
    },
    "marketplace_enabled": {
      "default": false,
      "type": "boolean"
    },
    "mode": {
      "default": "signage_ads",
      "description": "What the screen shows: advertising only, signage plus ads, or signage only",
      "enum": [
        "ads_only",
        "signage_ads",
        "signage_only"
      ],
      "enumColors": [
        "blue",
        "purple",
        "gray"
      ],
      "type": "string"
    },
    "monetization_mode": {
      "default": "marketplace",
      "enum": [
        "marketplace",
        "self_serve",
        "hybrid"
      ],
      "type": "string"
    },
    "name": {
      "description": "Screen name/identifier",
      "type": "string"
    },
    "offer_floor_per_week": {
      "description": "Lowest weekly offer the venue will see. Empty = 30% of the list price",
      "type": "number"
    },
    "org_id": {
      "description": "ID of the Organization that owns this screen",
      "type": "string"
    },
    "org_member_user_ids": {
      "description": "Denormalized from parent Organization.member_user_ids \u2014 drives RLS on this screen.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "orientation": {
      "default": "landscape",
      "enum": [
        "landscape",
        "portrait"
      ],
      "type": "string"
    },
    "owner_slot_1_type": {
      "default": "image",
      "enum": [
        "image",
        "video"
      ],
      "type": "string"
    },
    "owner_slot_1_url": {
      "type": "string"
    },
    "owner_slot_2_type": {
      "default": "image",
      "enum": [
        "image",
        "video"
      ],
      "type": "string"
    },
    "owner_slot_2_url": {
      "type": "string"
    },
    "owner_slot_3_type": {
      "default": "image",
      "enum": [
        "image",
        "video"
      ],
      "type": "string"
    },
    "owner_slot_3_url": {
      "type": "string"
    },
    "owner_slot_4_type": {
      "default": "image",
      "enum": [
        "image",
        "video"
      ],
      "type": "string"
    },
    "owner_slot_4_url": {
      "type": "string"
    },
    "owner_slot_5_type": {
      "default": "image",
      "enum": [
        "image",
        "video"
      ],
      "type": "string"
    },
    "owner_slot_5_url": {
      "type": "string"
    },
    "owner_slot_6_type": {
      "default": "image",
      "enum": [
        "image",
        "video"
      ],
      "type": "string"
    },
    "owner_slot_6_url": {
      "type": "string"
    },
    "paired_at": {
      "type": "string"
    },
    "paired_device_id": {
      "description": "The one device currently locked to this screen",
      "type": "string"
    },
    "pairing_code": {
      "description": "6 character code used to pair a device to this screen",
      "type": "string"
    },
    "player_command": {
      "description": "Pending command for the player, e.g. restart:1712345678",
      "type": "string"
    },
    "player_type": {
      "default": "browser",
      "enum": [
        "bone",
        "browser",
        "android_tv",
        "lg",
        "samsung"
      ],
      "type": "string"
    },
    "player_version": {
      "type": "string"
    },
    "position_label": {
      "description": "Where the screen sits, e.g. front counter",
      "type": "string"
    },
    "prayer_pause": {
      "description": "Pause the screen at each prayer time (times worked out on the player from the venue location)",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "jumuah_minutes": {
          "default": 45,
          "type": "number"
        },
        "minutes": {
          "default": 15,
          "type": "number"
        },
        "prayers": {
          "items": {
            "enum": [
              "fajr",
              "dhuhr",
              "asr",
              "maghrib",
              "isha"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "show": {
          "default": "card",
          "enum": [
            "card",
            "blank"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "price_per_week": {
      "type": "number"
    },
    "public_ad_slots": {
      "default": 7,
      "type": "number"
    },
    "rejection_reason": {
      "type": "string"
    },
    "screen_image_url": {
      "description": "Photo of the physical screen",
      "type": "string"
    },
    "screen_pin": {
      "type": "string"
    },
    "setup_code": {
      "description": "Legacy setup code for player (BW- prefix)",
      "type": "string"
    },
    "site_id": {
      "description": "ID of the Site this screen belongs to (enterprise grouping). Optional.",
      "type": "string"
    },
    "slot_duration": {
      "default": 30,
      "enum": [
        15,
        30,
        45,
        60
      ],
      "type": "number"
    },
    "status": {
      "default": "pending",
      "enum": [
        "active",
        "inactive",
        "offline",
        "pending"
      ],
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "total_impressions": {
      "default": 0,
      "type": "number"
    },
    "total_revenue": {
      "default": 0,
      "type": "number"
    },
    "total_slots": {
      "default": 10,
      "type": "number"
    },
    "uptime_seconds": {
      "default": 0,
      "type": "number"
    },
    "venue_id": {
      "description": "Venue this screen sits in (required for new screens)",
      "type": "string"
    },
    "width_px": {
      "description": "Screen width in pixels",
      "type": "number"
    }
  },
  "required": [
    "name"
  ],
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.approval_status": "approved"
            },
            {
              "data.status": "active"
            }
          ]
        },
        {
          "data.org_member_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.org_member_user_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.org_member_user_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}