{
  "name": "Screen",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "ID of the Organization that owns this screen"
    },
    "org_member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Denormalized from parent Organization.member_user_ids \u2014 drives RLS on this screen."
    },
    "venue_id": {
      "type": "string",
      "description": "Venue this screen sits in (required for new screens)"
    },
    "site_id": {
      "type": "string",
      "description": "ID of the Site this screen belongs to (enterprise grouping). Optional."
    },
    "name": {
      "type": "string",
      "description": "Screen name/identifier"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "mode": {
      "type": "string",
      "enum": [
        "ads_only",
        "signage_ads",
        "signage_only"
      ],
      "default": "signage_ads",
      "description": "What the screen shows: advertising only, signage plus ads, or signage only",
      "enumColors": [
        "blue",
        "purple",
        "gray"
      ]
    },
    "position_label": {
      "type": "string",
      "description": "Where the screen sits, e.g. front counter"
    },
    "orientation": {
      "type": "string",
      "enum": [
        "landscape",
        "portrait"
      ],
      "default": "landscape"
    },
    "player_type": {
      "type": "string",
      "enum": [
        "bone",
        "browser",
        "android_tv",
        "lg",
        "samsung"
      ],
      "default": "browser"
    },
    "pairing_code": {
      "type": "string",
      "description": "6 character code used to pair a device to this screen"
    },
    "paired_device_id": {
      "type": "string",
      "description": "The one device currently locked to this screen"
    },
    "paired_at": {
      "type": "string"
    },
    "device_token": {
      "type": "string",
      "description": "Secret the paired player uses to call the player endpoints"
    },
    "last_heartbeat": {
      "type": "string"
    },
    "is_online": {
      "type": "boolean",
      "default": false
    },
    "current_item": {
      "type": "string",
      "description": "What the player last reported as playing"
    },
    "player_version": {
      "type": "string"
    },
    "uptime_seconds": {
      "type": "number",
      "default": 0
    },
    "last_snapshot_url": {
      "type": "string",
      "description": "Private file_uri of the most recent player snapshot"
    },
    "player_command": {
      "type": "string",
      "description": "Pending command for the player, e.g. restart:1712345678"
    },
    "marketplace_enabled": {
      "type": "boolean",
      "default": false
    },
    "setup_code": {
      "type": "string",
      "description": "Legacy setup code for player (BW- prefix)"
    },
    "screen_pin": {
      "type": "string"
    },
    "screen_image_url": {
      "type": "string",
      "description": "Photo of the physical screen"
    },
    "default_image_url": {
      "type": "string",
      "description": "Image shown when the screen is stopped or has no content"
    },
    "width_px": {
      "type": "number",
      "description": "Screen width in pixels"
    },
    "height_px": {
      "type": "number",
      "description": "Screen height in pixels"
    },
    "display_mode": {
      "type": "string",
      "enum": [
        "fit",
        "stretch",
        "fill"
      ],
      "default": "fit"
    },
    "total_slots": {
      "type": "number",
      "default": 10
    },
    "public_ad_slots": {
      "type": "number",
      "default": 7
    },
    "internal_slots": {
      "type": "number",
      "default": 3
    },
    "slot_duration": {
      "type": "number",
      "enum": [
        15,
        30,
        45,
        60
      ],
      "default": 30
    },
    "price_per_week": {
      "type": "number"
    },
    "monetization_mode": {
      "type": "string",
      "enum": [
        "marketplace",
        "self_serve",
        "hybrid"
      ],
      "default": "marketplace"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "offline",
        "pending"
      ],
      "default": "pending"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "enumColors": [
        "yellow",
        "green",
        "red"
      ]
    },
    "location_description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejection_reason": {
      "type": "string"
    },
    "total_impressions": {
      "type": "number",
      "default": 0
    },
    "total_revenue": {
      "type": "number",
      "default": 0
    },
    "owner_slot_1_url": {
      "type": "string"
    },
    "owner_slot_1_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image"
    },
    "owner_slot_2_url": {
      "type": "string"
    },
    "owner_slot_2_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image"
    },
    "owner_slot_3_url": {
      "type": "string"
    },
    "owner_slot_3_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image"
    },
    "owner_slot_4_url": {
      "type": "string"
    },
    "owner_slot_4_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image"
    },
    "owner_slot_5_url": {
      "type": "string"
    },
    "owner_slot_5_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image"
    },
    "owner_slot_6_url": {
      "type": "string"
    },
    "owner_slot_6_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.approval_status": "approved"
            },
            {
              "data.status": "active"
            }
          ]
        },
        {
          "data.org_member_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.org_member_user_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.org_member_user_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}