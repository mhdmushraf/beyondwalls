{
  "name": "Membership",
  "type": "object",
  "properties": {
    "org_id": {
      "description": "The organization they belong to",
      "type": "string"
    },
    "role": {
      "default": "owner",
      "description": "Role within the organization",
      "enum": [
        "owner",
        "venue_manager",
        "designer",
        "viewer"
      ],
      "type": "string",
      "enumColors": [
        "blue",
        "purple",
        "pink",
        "gray"
      ]
    },
    "venue_ids": {
      "description": "Venues this member can access. Empty means every venue in the organization.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "current_org": {
      "default": false,
      "description": "True for the business the user last had open in the portal",
      "type": "boolean"
    },
    "user_email": {
      "description": "Denormalized user email for display",
      "type": "string"
    },
    "user_id": {
      "description": "The user who belongs to the org",
      "type": "string"
    },
    "user_name": {
      "description": "Denormalized user full name for display",
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "org_id",
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}