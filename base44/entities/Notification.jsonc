{
  "description": "In-app (and push) notification for one user. Created by server functions.",
  "name": "Notification",
  "properties": {
    "description": {
      "maxLength": 1000,
      "type": "string"
    },
    "is_read": {
      "default": false,
      "type": "boolean"
    },
    "link": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "org_id": {
      "type": "string"
    },
    "pushed": {
      "default": false,
      "type": "boolean"
    },
    "recipient_email": {
      "type": "string"
    },
    "recipient_user_id": {
      "type": "string"
    },
    "reference_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "enum": [
        "account_approved",
        "account_rejected",
        "campaign_approved",
        "campaign_rejected",
        "screen_approved",
        "screen_offline",
        "screen_recovered",
        "payout_processed",
        "payout_requested",
        "new_booking",
        "ad_review",
        "ad_approved",
        "ad_rejected",
        "payment_received",
        "wallet_low",
        "offer",
        "system"
      ],
      "type": "string"
    }
  },
  "required": [
    "recipient_email",
    "type",
    "title",
    "message"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "data.recipient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "data.recipient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}