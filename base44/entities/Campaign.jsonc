{
  "name": "Campaign",
  "properties": {
    "admin_notes": {
      "type": "string"
    },
    "advertiser_email": {
      "type": "string"
    },
    "advertiser_member_user_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "approval_status": {
      "default": "pending",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "type": "string"
    },
    "client_id": {
      "description": "Agency client this campaign is for",
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "creative_type": {
      "default": "image",
      "enum": [
        "image",
        "video"
      ],
      "type": "string"
    },
    "creative_urls": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "deal_type": {
      "default": "marketplace",
      "enum": [
        "marketplace",
        "direct"
      ],
      "type": "string"
    },
    "description": {
      "maxLength": 1000,
      "type": "string"
    },
    "end_date": {
      "format": "date",
      "type": "string"
    },
    "goal": {
      "default": "brand_awareness",
      "enum": [
        "brand_awareness",
        "drive_traffic",
        "promote_event",
        "product_launch",
        "other"
      ],
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "org_id": {
      "description": "Advertiser or agency organization this campaign belongs to",
      "type": "string"
    },
    "org_name": {
      "type": "string"
    },
    "payment_status": {
      "default": "unpaid",
      "enum": [
        "unpaid",
        "paid",
        "refunded"
      ],
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "selected_screens": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "spent_budget": {
      "default": 0,
      "type": "number"
    },
    "start_date": {
      "format": "date",
      "type": "string"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "active",
        "paused",
        "completed",
        "rejected",
        "cancelled"
      ],
      "type": "string"
    },
    "subtotal": {
      "type": "number"
    },
    "target_cities": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "target_venue_types": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "total_budget": {
      "description": "Total incl. VAT in AED",
      "type": "number"
    },
    "total_impressions": {
      "default": 0,
      "type": "number"
    },
    "total_plays": {
      "default": 0,
      "type": "number"
    },
    "vat": {
      "type": "number"
    },
    "weeks": {
      "type": "number"
    },
    "days": { "type": "number" }
  },
  "required": [
    "name",
    "goal",
    "total_budget"
  ],
  "rls": {
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.advertiser_member_user_ids": "{{user.id}}"
        },
        {
          "data.advertiser_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}