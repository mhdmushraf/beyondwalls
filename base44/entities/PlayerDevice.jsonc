{
  "name": "PlayerDevice",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "description": "Identifier generated by the player and kept in localStorage"
    },
    "device_token": {
      "type": "string",
      "description": "Secret the player uses to call the public player endpoints"
    },
    "pairing_code": {
      "type": "string",
      "description": "6 character code shown on the TV"
    },
    "status": {
      "type": "string",
      "enum": [
        "unclaimed",
        "claimed",
        "replaced"
      ],
      "default": "unclaimed",
      "enumColors": [
        "yellow",
        "green",
        "gray"
      ]
    },
    "screen_id": {
      "type": "string"
    },
    "org_id": {
      "type": "string"
    },
    "venue_id": {
      "type": "string"
    },
    "last_seen": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    }
  },
  "required": [
    "device_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}