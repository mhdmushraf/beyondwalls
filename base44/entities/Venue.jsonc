{
  "name": "Venue",
  "properties": {
    "address": {
      "description": "Full address",
      "type": "string"
    },
    "approval_status": {
      "default": "pending",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "audience_age_group": {
      "enum": [
        "under_18",
        "18_25",
        "25_35",
        "35_50",
        "50_plus",
        "mixed"
      ],
      "type": "string"
    },
    "audience_gender": {
      "enum": [
        "male_dominant",
        "female_dominant",
        "mixed"
      ],
      "type": "string"
    },
    "avg_dwell_time_minutes": {
      "description": "Average time visitors spend in venue (minutes)",
      "type": "number"
    },
    "avg_spend_range": {
      "enum": [
        "under_25",
        "25_50",
        "50_100",
        "100_plus"
      ],
      "type": "string"
    },
    "avg_stay_minutes": {
      "description": "Average time a visitor stays (minutes)",
      "type": "number"
    },
    "city": {
      "description": "City",
      "type": "string"
    },
    "closing_time": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "country": {
      "default": "UAE",
      "type": "string"
    },
    "daily_customers": {
      "description": "Average daily visitors",
      "type": "number"
    },
    "daily_footfall": {
      "description": "Estimated daily visitors",
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "emirate": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "logo_url": {
      "type": "string"
    },
    "longitude": {
      "type": "number"
    },
    "name": {
      "description": "Venue name",
      "type": "string"
    },
    "opening_hours": {
      "description": "Human readable opening hours, e.g. 08:00 - 23:00",
      "type": "string"
    },
    "opening_time": {
      "type": "string"
    },
    "org_id": {
      "description": "ID of the Organization that owns this venue",
      "type": "string"
    },
    "org_member_user_ids": {
      "description": "Denormalized from Organization.member_user_ids \u2014 drives RLS",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "owner_email": {
      "description": "Email of venue owner",
      "type": "string"
    },
    "peak_hours": {
      "description": "Peak visitor hours",
      "type": "string"
    },
    "photo_urls": {
      "description": "Up to 5 venue photos",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "rejection_reason": {
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "status": {
      "default": "pending",
      "enum": [
        "active",
        "inactive",
        "pending"
      ],
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "venue_group_tags": {
      "description": "Grouping tags for reporting, e.g. mall-branch, downtown",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "venue_type": {
      "description": "Type of venue",
      "enum": [
        "restaurant",
        "cafe",
        "gym",
        "mall",
        "coworking",
        "hotel",
        "clinic",
        "salon",
        "retail",
        "other"
      ],
      "type": "string"
    },
    "weekly_footfall": {
      "description": "Estimated weekly visitors",
      "type": "number"
    }
  },
  "required": [
    "name",
    "venue_type",
    "address",
    "city"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.status": "active"
        },
        {
          "data.org_member_user_ids": "{{user.id}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.org_member_user_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}