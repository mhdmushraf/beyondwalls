{
  "description": "Venue asks Beyond Walls to pay out its marketplace earnings. Created only by the venuePayout function.",
  "name": "PayoutRequest",
  "properties": {
    "account_holder_name": {
      "type": "string"
    },
    "admin_notes": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "bank_name": {
      "type": "string"
    },
    "booking_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "description": {
      "maxLength": 1000,
      "type": "string"
    },
    "eligible_snapshot": {
      "type": "number"
    },
    "iban": {
      "type": "string"
    },
    "kind": {
      "default": "venue",
      "enum": [
        "venue",
        "agency"
      ],
      "type": "string"
    },
    "org_id": {
      "type": "string"
    },
    "org_member_user_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "org_name": {
      "type": "string"
    },
    "processed_date": {
      "type": "string"
    },
    "reference_id": {
      "description": "Bank transfer reference when paid",
      "type": "string"
    },
    "requested_by_email": {
      "type": "string"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "approved",
        "paid",
        "rejected"
      ],
      "type": "string"
    },
    "swift_code": {
      "type": "string"
    },
    "venue_owner_email": {
      "type": "string"
    }
  },
  "required": [
    "venue_owner_email",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.org_member_user_ids": "{{user.id}}"
        },
        {
          "data.venue_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}