{
  "name": "PayoutRequest",
  "type": "object",
  "properties": {
    "venue_owner_email": {
      "type": "string"
    },
    "org_id": {
      "type": "string",
      "description": "ID of the organization whose earnings this payout draws down"
    },
    "amount": {
      "type": "number"
    },
    "eligible_snapshot": {
      "type": "number",
      "description": "Eligible balance at request time, for audit"
    },
    "reference_id": {
      "type": "string",
      "description": "Ties the request to the payout Transaction created when marked paid"
    },
    "description": {
      "type": "string",
      "description": "Optional payout request description (up to 1000 characters)",
      "maxLength": 1000
    },
    "bank_name": {
      "type": "string"
    },
    "account_holder_name": {
      "type": "string"
    },
    "iban": {
      "type": "string"
    },
    "swift_code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "paid",
        "rejected"
      ],
      "default": "pending"
    },
    "admin_notes": {
      "type": "string"
    },
    "processed_date": {
      "type": "string"
    }
  },
  "required": [
    "venue_owner_email",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.venue_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}